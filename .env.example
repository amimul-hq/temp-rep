# ==========================================
# MINOXIDIL WEBSITE - ENVIRONMENT CONFIG
# ==========================================
# All project data, products & configuration are managed locally via public/data/website-data.json
# No external MongoDB database connection required.

# 1. Admin Authentication
# Generate a unique signing secret, for example with: openssl rand -hex 32
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 2. Cloudinary (Optional - Direct image URL input and fallbacks available)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 3. Meta Facebook Pixel & Conversions API (CAPI)
META_PIXEL_ID=
VITE_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# 4. Application URLs & Environment
SITE_URL=http://localhost:3000
NODE_ENV=development
PORT=5000

# 5. External Order Mirroring (Optional MongoDB collection sync on order placement)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.bkbrwoa.mongodb.net/only_orders_details
